pipeline {
    agent any

    environment {
        GIT_CREDENTIALS_ID_PRIMARY = 'github-primary-credentials'
        GIT_CREDENTIALS_ID_SECONDARY = 'github-secondary-credentials'
        SOURCE_REPO = 'https://github.com/ravularajesh/raj.git'
        DEST_REPO = 'https://github.com/ravularajesh3333/vara.git'
        SOURCE_DIR = 'source-repo'
        DEST_DIR = 'destination-repo'
    }

    stages {
        stage('Debug Information') {
            steps {
                script {
                    echo "Repository URL: ${env.SOURCE_REPO}, credentialsId: ${env.GIT_CREDENTIALS_ID_PRIMARY}"
                    echo "Repository URL: ${env.DEST_REPO}, credentialsId: ${env.GIT_CREDENTIALS_ID_SECONDARY}"
                }
            }
        }

        stage('Clone Source Repository') {
            steps {
                script {
                    try {
                        echo 'Cloning the source repository'
                        dir(env.SOURCE_DIR) {
                            git url: env.SOURCE_REPO, credentialsId: env.GIT_CREDENTIALS_ID_PRIMARY
                        }
                    } catch (Exception e) {
                        echo 'Unable to clone source repository'
                        throw e
                    }
                }
            }
        }

        stage('Clone Destination Repository') {
            steps {
                script {
                    try {
                        echo 'Cloning the destination repository'
                        dir(env.DEST_DIR) {
                            git url: env.DEST_REPO, credentialsId: env.GIT_CREDENTIALS_ID_SECONDARY
                        }
                    } catch (Exception e) {
                        echo 'Unable to clone destination repository'
                        throw e
                    }
                }
            }
        }

        stage('Sync Files from Source to Destination') {
            steps {
                script {
                    sh "rsync -a --ignore-existing --exclude=.git ./${env.SOURCE_DIR}/ ./${env.DEST_DIR}/"
                }
            }
        }

        stage('Push Files and Tags to Destination Repo') {
            steps {
                script {
                    dir(env.DEST_DIR) {
                        withCredentials([usernamePassword(credentialsId: env.GIT_CREDENTIALS_ID_SECONDARY, usernameVariable: 'GIT_USERNAME', passwordVariable: 'GIT_PASSWORD')]) {
                            sh '''
                            git remote set-url origin https://${GIT_USERNAME}:${GIT_PASSWORD}@github.com/ravularajesh3333/vara.git
                            git add .
                            git checkout var
                            git fetch origin var
                            
                            git merge --no-edit origin/var
                            if ! git diff-index --quiet HEAD --; then
                                git commit -m "Files synced from source repo"
                                git push origin var
                            else
                                echo "No changes to commit"
                            fi
                            git push --tags origin var
                            '''
                        }
                    }
                }
            }
        }

        stage('Sync Files from Destination to Source') {
            steps {
                script {
                    sh "rsync -a --ignore-existing --exclude=.git ./${env.DEST_DIR}/ ./${env.SOURCE_DIR}/"
                }
            }
        }

        stage('Push Files and Tags to Source Repo') {
            steps {
                script {
                    dir(env.SOURCE_DIR) {
                        withCredentials([usernamePassword(credentialsId: env.GIT_CREDENTIALS_ID_PRIMARY, usernameVariable: 'GIT_USERNAME', passwordVariable: 'GIT_PASSWORD')]) {
                            sh '''
                            git remote set-url origin https://${GIT_USERNAME}:${GIT_PASSWORD}@github.com/ravularajesh/raj.git
                            git add .
                            git fetch origin master
                            git checkout master
                            
                            git merge --no-edit origin/master
                            if ! git diff-index --quiet HEAD --; then
                                git commit -m "Files synced from source repo"
                                git push origin master
                            else
                                echo "No changes to commit"
                            fi
                            git push --tags origin master
                            '''
                        }
                    }
                }
            }
        }
    }
}
